DATABASE_URL=sqlite:///./data/database/orders.db
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
SQLITE_QUERY_TIMEOUT_SECONDS=5
SQLITE_MAX_RESULT_ROWS=1000
